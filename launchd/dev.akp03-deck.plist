<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.akp03-deck</string>

	<!-- Installed copy, not the build output: a rebuild must not pull the
	     binary out from under a running agent. -->
	<key>ProgramArguments</key>
	<array>
		<string>/Users/devic021/.local/bin/akp03-deck</string>
	</array>

	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>

	<!-- launchd starts jobs with a bare PATH; `run` actions expect a
	     shell's one. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>

	<key>StandardOutPath</key>
	<string>/Users/devic021/Library/Logs/akp03-deck.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/devic021/Library/Logs/akp03-deck.log</string>
</dict>
</plist>
